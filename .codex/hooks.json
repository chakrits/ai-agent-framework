{
  "description": "GENERATED by scripts/sync-adapters.py - do not edit. POSIX command runs scripts/bin/sdlc-hook via sh; commandWindows runs scripts\\bin\\sdlc-hook.cmd through PowerShell (-EncodedCommand avoids quoting differences between cmd.exe and PowerShell). Trust these hooks with /hooks after review.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" session-start --platform codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" pretooluse --platform codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
