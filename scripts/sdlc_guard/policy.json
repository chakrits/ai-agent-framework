{
  "version": 1,
  "description": "Single source of truth for deterministic guardrails (Claude Code, Codex, git pre-commit). Globs are case-insensitive; bare names match any basename; '**/x' also matches at the repo root.",
  "write_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch"],
  "shell_tools": ["Bash", "PowerShell", "shell", "exec_command", "shell_command", "local_shell"],
  "allow_force_with_lease": false,
  "secret_globs": [".env", ".env.*", "**/secrets/**", "**/.ssh/**", "**/.aws/credentials", "**/.gnupg/**", "*.pem", "*.key", "id_rsa", "id_rsa.*", "id_ed25519", "id_ed25519.*"],
  "secret_allow_globs": [".env.example", ".env.sample", ".env.template", "*.example.pem"],
  "protected_globs": [
    "docs/operating-model/constitution.md",
    "docs/contracts/**",
    "scripts/sdlc_guard/**",
    "scripts/sdlc_hook.py",
    "scripts/bin/**",
    "scripts/guard-protected-paths.sh",
    ".githooks/**",
    ".claude/settings.json",
    ".codex/hooks.json",
    ".gitattributes",
    ".sdlc/**"
  ],
  "roles": {
    "dev-coding-agent": {
      "deny_protected_writes": true,
      "ci_gate_globs": ["scripts/validate-*.py", "scripts/sync-adapters.py", "scripts/precommit.py", "scripts/doctor.py", "scripts/setup.py", "evals/**", ".github/workflows/**", ".gitlab-ci.yml"],
      "qa_artifact_globs": ["**/test-report*.md", "**/test-cases/**", "**/test_cases/**"],
      "test_code_globs": ["tests/**", "**/tests/**", "**/test_*.py", "**/*_test.*", "**/*.spec.*", "**/*.test.*", "**/robot/**"],
      "test_code_mode": "tracked"
    }
  }
}
