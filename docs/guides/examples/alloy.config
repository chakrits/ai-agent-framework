// Grafana Alloy: ship agent trace JSONL to Loki.
// STATUS: NOT TESTED against a running Alloy/Loki. Verify the component arguments against the Alloy docs for your version
// (loki.source.file, loki.process: stage.json / stage.timestamp / stage.labels / stage.structured_metadata).
//
// Loki labels must stay LOW-CARDINALITY: only the fields below become labels. session_id, work_item, prompt_id,
// tool_use_id and the command text stay in the log line / structured metadata and are queried with `| json`.

local.file_match "sdlc_agent_trace" {
  // Windows: "C:\\path\\to\\repo\\.sdlc\\traces\\*\\*.jsonl"
  path_targets = [{
    "__path__" = "/path/to/repo/.sdlc/traces/*/*.jsonl",
    "job"      = "sdlc-agent-trace",
  }]
}

loki.source.file "sdlc_agent_trace" {
  targets    = local.file_match.sdlc_agent_trace.targets
  forward_to = [loki.process.sdlc_agent_trace.receiver]
}

loki.process "sdlc_agent_trace" {
  // Pull fields out of each JSON line.
  stage.json {
    expressions = {
      ts         = "ts",
      platform   = "platform",
      os         = "os",
      operation  = "operation",
      event_name = "event",
      role       = "role",
      tool_name  = "tool_name",
      model      = "model",
      effort     = "effort",
      session_id = "session_id",
      work_item  = "work_item",
      prompt_id  = "prompt_id",
    }
  }

  // `ts` is local time with an offset (e.g. 2026-11-21T12:34:56.789+07:00); Go's RFC3339 parsing accepts the fraction.
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      platform  = "",
      os        = "",
      operation = "",
      role      = "",
      tool_name = "",
      model     = "",
      effort    = "",
      event     = "event_name",
    }
  }

  stage.structured_metadata {
    values = {
      session_id = "",
      work_item  = "",
      prompt_id  = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
