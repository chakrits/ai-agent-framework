// Docker Compose Grafana Alloy configuration for local trace testing.
local.file_match "sdlc_agent_trace" {
  path_targets = [{
    "__path__" = "/traces/*/*.jsonl",
    "job"      = "sdlc-agent-trace",
  }]
}

loki.source.file "sdlc_agent_trace" {
  targets    = local.file_match.sdlc_agent_trace.targets
  forward_to = [loki.process.sdlc_agent_trace.receiver]
}

loki.process "sdlc_agent_trace" {
  stage.json {
    expressions = {
      ts         = "ts",
      platform   = "platform",
      os         = "os",
      operation  = "operation",
      event_name = "event",
      role       = "role",
      tool_name  = "tool_name",
      model      = "model",
      effort     = "effort",
      session_id = "session_id",
      work_item  = "work_item",
      prompt_id  = "prompt_id",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      platform  = "",
      os        = "",
      operation = "",
      role      = "",
      tool_name = "",
      model     = "",
      effort    = "",
      event     = "event_name",
    }
  }

  stage.structured_metadata {
    values = {
      session_id = "",
      work_item  = "",
      prompt_id  = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
