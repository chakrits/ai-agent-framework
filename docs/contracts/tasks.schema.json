{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc-framework.local/contracts/tasks.schema.json",
  "title": "SDLC Implementation Tasks State",
  "description": "Machine-verifiable implementation task checklist for coding agents.",
  "type": "object",
  "required": ["spec_ref", "intent_ref", "tasks"],
  "additionalProperties": false,
  "properties": {
    "intent_ref": {
      "type": "string",
      "pattern": "^INT-[0-9]{3,}$"
    },
    "spec_ref": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3,}$"
    },
    "test_report_ref": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "fs_refs",
          "test_refs",
          "status",
          "passes",
          "verification_cmd"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "description": {
            "type": "string"
          },
          "fs_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^FS-[0-9]{3,}$"
            }
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(TC-(HC|NEG|BVA|EP|API|PERF|SEC)-[0-9]{3,}|EXP-[0-9]{3,}|UNIT-[0-9]{3,})$"
            }
          },
          "target_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "blocked", "completed"]
          },
          "passes": {
            "type": "boolean",
            "description": "Must become true ONLY after verification_cmd executes cleanly with exit code 0."
          },
          "verification_cmd": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
