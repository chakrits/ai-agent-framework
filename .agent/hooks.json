{
  "sdlc-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" session-start --platform antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" pretooluse --platform antigravity",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" trace --platform antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh \"$(git rev-parse --show-toplevel)/scripts/bin/sdlc-hook\" trace --platform antigravity",
        "timeout": 10
      }
    ]
  }
}
